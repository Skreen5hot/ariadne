<https://fandaws.com/ontology/bfo/valuenet-mappings.owl>
  a owl:Ontology ;
  dc:license <https://creativecommons.org/licenses/by/4.0/> ;
  owl:imports <https://fandaws.com/ontology/bfo/valuenet-moral-foundations.owl> ;
  dc:title "ValueNet Mappings"@en ;
  dc:description "Provides annotation-only correspondences from BFO-aligned ValueNet entities to entities in the original ValueNet and related value ontologies: historical correspondences, and the folk corpus values that D-014 records as related to a class without naming it."@en .

